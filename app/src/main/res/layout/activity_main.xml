<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    tools:context=".MainActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:title="Traductor de Señas"
        android:titleTextColor="@color/white"
        android:backgroundTint="@color/aqua"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="0dp"
        android:layout_height="220dp"
        android:layout_margin="12dp"
        android:background="#000000"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardResultado"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp"
        app:layout_constraintTop_toBottomOf="@id/previewView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/txtResultado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Traducción aparecerá aquí"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:gravity="center"
            android:padding="20dp"/>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/layoutBotones"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_margin="12dp"
        app:layout_constraintTop_toBottomOf="@id/cardResultado"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHablar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reproducir Voz"
            android:textColor="@color/white"
            android:backgroundTint="@color/mint"
            app:icon="@android:drawable/ic_lock_silent_mode_off"
            app:iconPadding="8dp"
            android:minHeight="60dp"
            android:contentDescription="Reproducir voz"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEscuchar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Voz a Texto"
            android:textColor="@color/white"
            android:backgroundTint="@color/blue_soft"
            app:icon="@android:drawable/ic_btn_speak_now"
            app:iconPadding="8dp"
            android:layout_marginTop="10dp"
            android:minHeight="60dp"
            android:contentDescription="Convertir voz a texto"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnModo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Modo Conversación"
            android:textColor="@color/white"
            android:backgroundTint="@color/teal_soft"
            app:icon="@android:drawable/ic_menu_rotate"
            app:iconPadding="8dp"
            android:layout_marginTop="10dp"
            android:minHeight="60dp"
            android:contentDescription="Cambiar modo conversación"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>a