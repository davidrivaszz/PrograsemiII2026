<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    tools:context=".MainActivity">

    <!-- TOP BAR -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:title="Traductor de Señas"
        android:titleTextColor="@color/white"
        android:backgroundTint="@color/aqua"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- CÁMARA PREVIEW -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="0dp"
        android:layout_height="220dp"
        android:layout_margin="12dp"
        android:elevation="4dp"
        android:clipToOutline="true"
        android:outlineProvider="background"
        android:background="@drawable/rounded_preview_bg"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- BADGE: CÁMARA ACTIVA -->
    <TextView
        android:id="@+id/tvCameraStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="● EN VIVO"
        android:textColor="#FF4444"
        android:textSize="11sp"
        android:textStyle="bold"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        app:layout_constraintTop_toTopOf="@id/previewView"
        app:layout_constraintEnd_toEndOf="@id/previewView"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"/>

    <!-- CARD: TRADUCCIÓN -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardTranslation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="12dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="@color/white"
        app:layout_constraintTop_toBottomOf="@id/previewView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TRADUCCIÓN"
                android:textSize="10sp"
                android:textColor="@color/aqua"
                android:textStyle="bold"
                android:letterSpacing="0.15"/>

            <TextView
                android:id="@+id/tvTranslation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Traducción aparecerá aquí"
                android:textSize="22sp"
                android:textColor="#1A1A2E"
                android:textStyle="bold"
                android:gravity="center"
                android:minHeight="60dp"/>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- BOTÓN: REPRODUCIR VOZ -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnHablar"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="12dp"
        android:text="📢  REPRODUCIR VOZ"
        android:textSize="13sp"
        android:textColor="@color/white"
        android:letterSpacing="0.08"
        app:backgroundTint="@color/aqua"
        app:cornerRadius="26dp"
        app:iconGravity="textStart"
        app:layout_constraintTop_toBottomOf="@id/cardTranslation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- BOTÓN: VOZ A TEXTO -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEscuchar"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="10dp"
        android:text="🎙️  VOZ A TEXTO"
        android:textSize="13sp"
        android:textColor="@color/white"
        android:letterSpacing="0.08"
        app:backgroundTint="@color/mint"
        app:cornerRadius="26dp"
        app:layout_constraintTop_toBottomOf="@id/btnHablar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- BOTÓN: MODO CONVERSACIÓN -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnModo"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="10dp"
        android:text="🔄  MODO CONVERSACIÓN"
        android:textSize="13sp"
        android:textColor="@color/white"
        android:letterSpacing="0.08"
        app:backgroundTint="@color/teal"
        app:cornerRadius="26dp"
        app:layout_constraintTop_toBottomOf="@id/btnEscuchar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- FOOTER INFO -->
    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="16dp"
        android:text="🤟 Apunta la cámara hacia las manos para detectar señas"
        android:textSize="12sp"
        android:textColor="#888888"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/btnModo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>